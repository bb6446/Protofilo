{
  "name": "animated-3d-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "optimize:images": "node src/scripts/optimize-images.mjs",
    "deploy:netlify": "npm run build && npx netlify deploy --prod --dir=dist",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "deploy:ci": "npm run build && firebase deploy --only hosting --non-interactive",
    "firebase": "firebase",
    "netlify": "netlify"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.2",
    "gsap": "^3.12.5",
    "lucide": "^0.344.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.28.2",
    "sharp": "^0.35.4",
    "vite": "^5.1.4",
    "vitest": "^4.1.11"
  }
}
